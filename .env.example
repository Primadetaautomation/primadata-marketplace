# Database Configuration (Supabase or PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/recruitment_db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# API Configuration
API_KEY=your-secure-api-key-here
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,chrome-extension://your-extension-id

# AI Services
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Email Services (Choose one or configure multiple)
# Postmark
POSTMARK_API_KEY=your-postmark-key

# Mailgun
MAILGUN_API_KEY=your-mailgun-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_HOST=smtp.eu.mailgun.org

# SMTP (Generic)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Configuration
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Recruitment Team
NOTIFICATION_EMAIL=admin@yourdomain.com

# Enrichment Services
FIRECRAWL_API_KEY=fc-...
SERPER_API_KEY=your-serper-key
HUNTER_API_KEY=your-hunter-key
APOLLO_API_KEY=your-apollo-key

# Logging
LOG_LEVEL=debug

# Redis (Optional, for job queue)
REDIS_URL=redis://localhost:6379

# Chrome Extension
EXTENSION_ID=your-chrome-extension-id